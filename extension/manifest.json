{
  "manifest_version": 3,
  "name": "영상노트 보내기",
  "version": "1.0.0",
  "description": "지금 보는 유튜브 영상·웹 글을 내 컴퓨터의 영상노트로 보내고, 영상의 마음에 드는 구간을 스크랩해요.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "영상노트로 보내기", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"] }]
}
